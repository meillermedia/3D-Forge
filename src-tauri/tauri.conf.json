{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3DForge",
  "version": "0.6.0",
  "identifier": "de.oth-aw.3dforge",
  "build": {
    "beforeDevCommand": "node scripts/prepare-app.js",
    "beforeBuildCommand": "node scripts/prepare-app.js",
    "frontendDist": "../dist-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "3DForge", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "GraphicsAndDesign",
    "copyright": "© 2026 by Dieter Meiller",
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
